{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prompt-regression:schema:regression-bundle:v1alpha1",
  "title": "Prompt Regression Bundle v1alpha1",
  "description": "Vendor-neutral, reproducible input for detecting and diagnosing a prompt regression.",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "diagnosis_requested_at",
    "project",
    "prompt",
    "dataset",
    "baseline_prompt_version",
    "candidate_prompt_version",
    "baseline_eval_run",
    "candidate_eval_run",
    "detection",
    "mock_ablation_results_by_segment"
  ],
  "properties": {
    "schema_version": {
      "const": "prompt-regression.bundle/v1alpha1",
      "description": "Discriminator for this exact bundle contract."
    },
    "bundle_id": {
      "$ref": "#/$defs/Id",
      "description": "Stable identifier for this immutable diagnosis input."
    },
    "diagnosis_requested_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "project": {
      "$ref": "#/$defs/Project"
    },
    "prompt": {
      "$ref": "#/$defs/Prompt"
    },
    "dataset": {
      "$ref": "#/$defs/Dataset"
    },
    "baseline_prompt_version": {
      "$ref": "#/$defs/PromptVersion"
    },
    "candidate_prompt_version": {
      "$ref": "#/$defs/PromptVersion"
    },
    "baseline_eval_run": {
      "$ref": "#/$defs/EvalRun"
    },
    "candidate_eval_run": {
      "$ref": "#/$defs/EvalRun"
    },
    "detection": {
      "$ref": "#/$defs/DetectionConfig"
    },
    "mock_ablation_results_by_segment": {
      "type": "object",
      "description": "Deterministic test fixture: candidate segment ID to the EvalResult values produced when that segment is reverted. An empty object means that no mock ablation result is available.",
      "propertyNames": {
        "$ref": "#/$defs/Id"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/EvalResult"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s]+$",
      "description": "Opaque stable identifier; consumers must not infer meaning from its spelling."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hexadecimal SHA-256 digest of canonical JSON."
    },
    "JsonValue": {
      "description": "Any value representable by JSON; NaN and infinity are not JSON values.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "JsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "Project": {
      "title": "Project",
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "Prompt": {
      "title": "Prompt",
      "type": "object",
      "required": ["id", "project_id", "name"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "PromptSegment": {
      "title": "PromptSegment",
      "description": "One stable, addressable segment of a prompt version.",
      "type": "object",
      "required": ["id", "kind", "content", "ordinal", "semantic_tags"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000,
          "pattern": "\\S"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "semantic_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "PromptVersion": {
      "title": "PromptVersion",
      "description": "An immutable prompt version composed of stable segments.",
      "type": "object",
      "required": ["id", "prompt_id", "version", "segments"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "prompt_id": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PromptSegment"
          }
        },
        "content_hash": {
          "$ref": "#/$defs/Sha256",
          "description": "Optional producer-supplied hash. When present it must match the canonical segments hash recomputed by the consumer."
        }
      },
      "additionalProperties": false
    },
    "TestCase": {
      "title": "TestCase",
      "type": "object",
      "required": ["id", "input"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "input": {
          "$ref": "#/$defs/JsonObject",
          "description": "Vendor-neutral structured input supplied to the model."
        },
        "expected": {
          "description": "Optional structured expectation used by evaluators.",
          "oneOf": [
            {
              "$ref": "#/$defs/JsonObject"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "$ref": "#/$defs/JsonObject",
          "default": {},
          "description": "Integration-owned extension data; it must not replace modeled contract fields."
        }
      },
      "additionalProperties": false
    },
    "Dataset": {
      "title": "Dataset",
      "type": "object",
      "required": ["id", "project_id", "name", "test_cases"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "test_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/TestCase"
          }
        }
      },
      "additionalProperties": false
    },
    "MetricResult": {
      "title": "MetricResult",
      "description": "A metric value object scoped to one EvalResult.",
      "type": "object",
      "required": ["metric_key", "score"],
      "properties": {
        "metric_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Normalized score in the closed interval [0, 1]; v1alpha1 treats higher values as better."
        },
        "passed": {
          "type": ["boolean", "null"]
        },
        "reason": {
          "type": ["string", "null"],
          "maxLength": 10000
        }
      },
      "additionalProperties": false
    },
    "EvalResult": {
      "title": "EvalResult",
      "type": "object",
      "required": ["id", "test_case_id", "output_text", "passed", "metrics"],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "test_case_id": {
          "$ref": "#/$defs/Id"
        },
        "output_text": {
          "type": "string",
          "maxLength": 1000000
        },
        "passed": {
          "type": "boolean"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/MetricResult"
          }
        },
        "metadata": {
          "$ref": "#/$defs/JsonObject",
          "default": {},
          "description": "Integration-owned extension data; it must not replace modeled contract fields."
        }
      },
      "additionalProperties": false
    },
    "EvalRun": {
      "title": "EvalRun",
      "description": "A reproducible set of evaluation results for one prompt and dataset version.",
      "type": "object",
      "required": [
        "id",
        "prompt_version_id",
        "dataset_id",
        "results",
        "model_snapshot",
        "evaluator_snapshot"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "prompt_version_id": {
          "$ref": "#/$defs/Id"
        },
        "dataset_id": {
          "$ref": "#/$defs/Id"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/EvalResult"
          }
        },
        "model_snapshot": {
          "$ref": "#/$defs/JsonObject",
          "type": "object",
          "minProperties": 1,
          "description": "Pinned model identity and generation parameters needed for reproduction."
        },
        "evaluator_snapshot": {
          "$ref": "#/$defs/JsonObject",
          "type": "object",
          "minProperties": 1,
          "description": "Pinned evaluator identity, rubric, and parameters needed for reproduction."
        }
      },
      "additionalProperties": false
    },
    "DetectionConfig": {
      "title": "DetectionConfig",
      "type": "object",
      "required": [
        "primary_metric",
        "metric_drop_threshold",
        "min_target_cases",
        "min_control_cases",
        "support_recovery_ratio",
        "reject_recovery_ratio",
        "max_control_damage"
      ],
      "properties": {
        "primary_metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S",
          "description": "Metric used for regression and recovery gates. v1alpha1 requires a normalized higher-is-better metric."
        },
        "metric_drop_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_target_cases": {
          "type": "integer",
          "minimum": 1
        },
        "min_control_cases": {
          "type": "integer",
          "minimum": 1
        },
        "support_recovery_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reject_recovery_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_control_damage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
