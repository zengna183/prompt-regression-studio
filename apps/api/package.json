{
  "name": "@ai-chat-eval/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "auth:bootstrap": "tsx --env-file=../../.env src/bootstrap-admin.ts",
    "auth:reset-password": "tsx --env-file=../../.env src/reset-password.ts",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "node ../../scripts/clean-build-output.mjs && tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@ai-chat-eval/contracts": "workspace:*",
    "@ai-chat-eval/db": "workspace:*",
    "@ai-chat-eval/queue": "workspace:*",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/sensible": "6.0.7",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/type-provider-typebox": "6.3.0",
    "@prompt-regression/diagnosis-engine": "workspace:*",
    "@prompt-regression/model-provider": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "csv-parse": "7.0.3",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  }
}
