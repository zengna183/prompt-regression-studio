NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Required in production. Generate a random value with at least 32 characters.
API_AUTH_TOKEN=
API_BODY_LIMIT_BYTES=8388608
API_DOCS_ENABLED=true
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
API_TRUST_PROXY=false
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://eval:eval@localhost:5432/eval_studio
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4101
WORKER_CONCURRENCY=4
MAX_ACTIVE_EXPERIMENTS_PER_PROJECT=8
WORKER_SHUTDOWN_TIMEOUT_MS=30000
LOG_LEVEL=info
MODEL_PROVIDER_BASE_URL=http://127.0.0.1:11434
MODEL_PROVIDER_API_KEY=local-development-key
MODEL_PROVIDER_ALLOW_PRIVATE_NETWORK=true
MODEL_PROVIDER_TIMEOUT_MS=60000
# Optional: enable AI-generated draft cases in the dataset workspace.
# Use a model available at MODEL_PROVIDER_BASE_URL; no key is sent to the browser.
DATASET_GENERATION_MODEL=
# Set false only when the configured OpenAI-compatible endpoint rejects the seed field.
MODEL_PROVIDER_SUPPORTS_SEED=true
# Project-scoped model connections: set the SAME base64-encoded 32-byte key in API and worker.
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Back up this key outside the database; losing it makes stored provider keys unreadable.
MODEL_ENCRYPTION_KEY=
# Production only: comma-separated exact DNS hostnames allowed for managed connections.
MODEL_PROVIDER_ALLOWED_HOSTS=
DIAGNOSIS_PYTHON_EXECUTABLE=python
DIAGNOSIS_PYTHONPATH=../../packages/python/core/src
DIAGNOSIS_TIMEOUT_MS=120000
DIAGNOSIS_MAX_CONCURRENCY=2
DIAGNOSIS_RATE_LIMIT_MAX=10
VITE_API_URL=http://localhost:4000
# Authentication: legacy keeps the existing shared API_AUTH_TOKEN behavior.
# After db:migrate, set AUTH_BOOTSTRAP_EMAIL / AUTH_BOOTSTRAP_PASSWORD in your shell,
# run pnpm auth:bootstrap, remove the bootstrap password, then switch to team.
# Optional AUTH_BOOTSTRAP_CLAIM_EXISTING_PROJECTS=true assigns existing projects
# to the first admin. Without it, legacy project data remains unassigned/inaccessible.
# Team mode ignores the shared token: every API request needs a personal login session.
AUTH_MODE=legacy
