NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Required in production. Generate a random value with at least 32 characters.
API_AUTH_TOKEN=
API_BODY_LIMIT_BYTES=8388608
API_DOCS_ENABLED=true
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
API_TRUST_PROXY=false
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://eval:eval@localhost:5432/eval_studio
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4101
WORKER_CONCURRENCY=4
WORKER_SHUTDOWN_TIMEOUT_MS=30000
LOG_LEVEL=info
MODEL_PROVIDER_BASE_URL=http://127.0.0.1:11434
MODEL_PROVIDER_API_KEY=local-development-key
MODEL_PROVIDER_ALLOW_PRIVATE_NETWORK=true
MODEL_PROVIDER_TIMEOUT_MS=60000
DIAGNOSIS_PYTHON_EXECUTABLE=python
DIAGNOSIS_PYTHONPATH=../../packages/python/core/src
DIAGNOSIS_TIMEOUT_MS=120000
DIAGNOSIS_MAX_CONCURRENCY=2
DIAGNOSIS_RATE_LIMIT_MAX=10
MODEL_ENCRYPTION_KEY=replace-with-a-32-byte-secret-before-storing-provider-keys
VITE_API_URL=http://localhost:4000
